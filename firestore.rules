rules_version = '2';

// Regras do Firestore do projeto site-amendola.
// Este arquivo NAO e aplicado sozinho: copie o conteudo para
// Console do Firebase > Firestore Database > Regras > Publicar.
//
// - clientes e links: qualquer visitante le (as paginas sao publicas);
//   so administradores gravam.
// - admin = usuario do Firebase Authentication que tem um documento
//   admins/{uid} (criado a mao no console; o site nunca cria admin).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function textoObrigatorio(campo) {
      return request.resource.data[campo] is string
        && request.resource.data[campo].size() > 0;
    }

    match /clientes/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && textoObrigatorio('nome')
        && request.resource.data.links is list;
    }

    match /links/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && textoObrigatorio('titulo')
        && textoObrigatorio('url');
    }

    // Cada usuario logado so consegue ver se ELE mesmo e admin.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
